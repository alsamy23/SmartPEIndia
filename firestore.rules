rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions: Authentication & Tenancy Checks
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'alsamy36@gmail.com' ||
          request.auth.token.email == 'admin@smartpeindia.app' ||
          request.auth.token.email == 'contact@smartpeindia.app' ||
          request.auth.token.email == 'info@smartpeindia.app'
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Explicit School Membership Verification
    // Allows personal teacher workspaces (personal_UID, school_UID) and verified school members
    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (schoolId != null && schoolId != '' && (
          schoolId == request.auth.uid ||
          schoolId == 'personal_' + request.auth.uid ||
          schoolId == 'school_' + request.auth.uid ||
          (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
           get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.schoolId == schoolId)
        ))
      );
    }

    // Explicit School Admin Verification
    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (schoolId != null && schoolId != '' && (
          schoolId == request.auth.uid ||
          schoolId == 'personal_' + request.auth.uid ||
          schoolId == 'school_' + request.auth.uid ||
          (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
           get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.schoolId == schoolId &&
           get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.role == 'admin')
        ))
      );
    }

    // Explicit Academy / Sports Coaching Program Tenancy Verification
    function isAcademyMember(programId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (programId != null && programId != '' && (
          (exists(/databases/$(database)/documents/academic_programs/$(programId)) && (
            get(/databases/$(database)/documents/academic_programs/$(programId)).data.headCoachId == request.auth.uid ||
            (request.auth.uid in get(/databases/$(database)/documents/academic_programs/$(programId)).data.coachUids) ||
            (request.auth.token.email != null && request.auth.token.email in get(/databases/$(database)/documents/academic_programs/$(programId)).data.coachEmails)
          ))
        ))
      );
    }

    // ===============================================================
    // Collection Rules: Multi-Tenant Authorization
    // ===============================================================

    // 1. User Profiles: Own user record, school peers, or Super Admin
    match /users/{uid} {
      allow read: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() ||
        (resource != null && resource.data.schoolId != null && isSchoolMember(resource.data.schoolId)) ||
        (resource != null && resource.data.academyId != null && isAcademyMember(resource.data.academyId))
      );
      allow create, update: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() ||
        (resource != null && resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow delete: if isAuthenticated() && (isOwner(uid) || isSuperAdmin());
    }

    // 2. Schools: Scoped to school members and admins
    match /schools/{schoolId} {
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.adminId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isAuthenticated() && (isSchoolAdmin(schoolId) || isSuperAdmin());
    }

    // 3. School Members: Authenticated user self, school members of same school, or school admin
    match /schoolMembers/{uid} {
      allow read: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (resource != null && resource.data.email == request.auth.token.email) ||
        (resource != null && resource.data.schoolId != null && isSchoolMember(resource.data.schoolId))
      );
      allow create: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId))
      );
      allow update: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (resource != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow delete: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (resource != null && isSchoolAdmin(resource.data.schoolId))
      );
    }

    // 4. Students: Scoped strictly to teacher/creator, school tenant, or Super Admin
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 5. Teams / Classes: Scoped strictly to teacher, school tenant, or Super Admin
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 6. Fitness Test Results: Scoped strictly to teacher, school tenant, or Super Admin
    match /results/{resultId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 7. Practical Assessments (CBSE Board 30M): Scoped to teacher/examiner, school tenant, or Super Admin
    match /practical_assessments/{assessmentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 8. Physical Development Interventions & Reassessments: Scoped to teacher, school tenant, or Super Admin
    match /interventions/{interventionId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 9. Academic Coaching Programs: Head Coach, Cohort Coaches, Invite Code, or Super Admin
    match /academic_programs/{programId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isAcademyMember(programId) ||
        (resource != null && resource.data.inviteCode != null)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.headCoachId == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.headCoachId == request.auth.uid) ||
        isAcademyMember(programId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource != null && resource.data.headCoachId == request.auth.uid)
      );
    }

    // 10. Academic Athletes: Scoped strictly to coach or academy tenant or Super Admin
    match /academic_athletes/{athleteId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.createdByCoachId == request.auth.uid ||
        request.resource.data.coachId == request.auth.uid ||
        isAcademyMember(request.resource.data.programId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
    }

    // 11. Academic Assessments: Scoped strictly to coach or academy tenant or Super Admin
    match /academic_assessments/{assessmentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.createdByCoachId == request.auth.uid ||
        request.resource.data.coachId == request.auth.uid ||
        isAcademyMember(request.resource.data.programId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
    }

    // 12. Workloads & Timetables: Strictly scoped to creator or school tenant
    match /workloads/{workloadId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 12b. Composite PE Term Evaluations (100-Mark Grading): Strictly scoped & validated per school/teacher tenant
    function isValidCompositeEvaluation(data) {
      return data.keys().hasAll([
        'id', 'schoolId', 'teacherId', 'studentId', 'studentName', 'term', 'totalScore', 'weights', 'fitnessSnapshot', 'discipline', 'games'
      ]) &&
      data.id is string && data.id.size() > 0 && data.id.size() <= 160 &&
      data.schoolId is string && data.schoolId.size() > 0 && data.schoolId.size() <= 160 &&
      data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 160 &&
      data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 160 &&
      data.studentName is string && data.studentName.size() <= 200 &&
      data.term is string && data.term.size() <= 60 &&
      data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100 &&
      data.weights is map &&
      data.fitnessSnapshot is map &&
      data.discipline is map &&
      data.games is map;
    }

    match /composite_evaluations/{evalId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && isValidCompositeEvaluation(request.resource.data) && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && isValidCompositeEvaluation(request.resource.data) && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 13. Sports Days: Scoped strictly to school members and admins
    match /sportsDays/{schoolId} {
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin());
      allow create, update, delete: if isAuthenticated() && (isSchoolAdmin(schoolId) || isSuperAdmin());
    }

    // 14. System Error Logs: Authenticated users write error logs; read only by super admin
    match /system_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    // 15. Privacy Audit Logs: Authenticated users write sanitized security logs; read only by user, school admin, or super admin
    match /privacy_audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSchoolAdmin(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    // 16. School Deletion Requests: Verified school admins can submit, read, or clean up; super admin can manage
    match /deletion_requests/{reqId} {
      allow create: if isAuthenticated() && (
        request.resource.data.requestedByUid == request.auth.uid &&
        isSchoolAdmin(request.resource.data.schoolId)
      );
      allow read: if isAuthenticated() && (
        resource.data.requestedByUid == request.auth.uid ||
        isSchoolAdmin(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || (
        isAuthenticated() &&
        resource != null &&
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    // 17. Mail Logs: Super Admin only
    match /mail_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // 18. Login Activity & App Usage Logs: Authenticated users can record/delete their own logs; Super Admin can monitor all
    match /login_activity/{logId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource != null && resource.data.uid == request.auth.uid);
    }

    // 18b. Sanitized Usage Events (Tool Usage & Downloads - Zero Student PII)
    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsageEvent(data) {
      return data.keys().hasAll(['id', 'uid', 'eventType', 'featureName', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'uid', 'userEmail', 'userName', 'schoolName', 'workspaceType',
          'eventType', 'featureName', 'category', 'format', 'timestamp'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 160 &&
        data.uid is string && data.uid == request.auth.uid &&
        data.eventType in ['tool_used', 'resource_downloaded', 'resource_viewed', 'resource_shared'] &&
        data.featureName is string && data.featureName.size() > 0 && data.featureName.size() <= 160 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 200)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 160)) &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 200)) &&
        (!('workspaceType' in data) || data.workspaceType in ['school', 'academy']) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('format' in data) || (data.format is string && data.format.size() <= 40));
    }

    match /usage_events/{eventId} {
      allow list: if isSuperAdmin();
      allow get: if isValidDocId(eventId) && isSuperAdmin();
      allow create: if isAuthenticated() && isValidDocId(eventId) && isValidUsageEvent(request.resource.data);
      allow update, delete: if isValidDocId(eventId) && isSuperAdmin();
    }

    // 18c. Teacher Feedback: Authenticated teachers submit feedback; Super Admin reviews and manages all
    function isValidTeacherFeedback(data) {
      return data.keys().hasAll(['id', 'uid', 'teacherName', 'category', 'rating', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'uid', 'teacherName', 'teacherEmail', 'schoolName', 'workspaceType',
          'category', 'rating', 'message', 'status', 'adminNote', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 160 &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 160 &&
        data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 120 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.message is string && data.message.size() >= 3 && data.message.size() <= 2000 &&
        data.status in ['new', 'reviewed', 'resolved'] &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        (!('teacherEmail' in data) || (data.teacherEmail is string && data.teacherEmail.size() <= 200)) &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 200)) &&
        (!('workspaceType' in data) || data.workspaceType in ['school', 'academy']) &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /teacher_feedback/{feedbackId} {
      allow list: if isSuperAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow get: if isValidDocId(feedbackId) && (isSuperAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid));
      allow create: if isAuthenticated() &&
        isValidDocId(feedbackId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        isValidTeacherFeedback(request.resource.data);
      allow update: if isValidDocId(feedbackId) &&
        isSuperAdmin() &&
        isValidTeacherFeedback(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidDocId(feedbackId) && (
        isSuperAdmin() ||
        (isAuthenticated() && resource != null && resource.data.uid == request.auth.uid)
      );
    }

    // 19. Default fallback: Deny all by default unless super admin
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
