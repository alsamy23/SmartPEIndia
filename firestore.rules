rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions: Authentication & Tenancy Checks
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'alsamy36@gmail.com' ||
        request.auth.token.email == 'admin@smartpeindia.com' ||
        request.auth.token.email == 'admin@smartpeindia.app' ||
        request.auth.token.email == 'contact@smartpeindia.app' ||
        request.auth.token.email == 'info@smartpeindia.app' ||
        request.auth.uid == 'admin@smartpeindia.app'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Explicit School Membership Verification
    // Allows personal teacher workspaces (personal_UID, school_UID) and verified school members
    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (schoolId != null && schoolId != '' && (
          schoolId == request.auth.uid ||
          schoolId == 'personal_' + request.auth.uid ||
          schoolId == 'school_' + request.auth.uid ||
          (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
           get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.schoolId == schoolId)
        ))
      );
    }

    // Explicit School Admin Verification
    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (schoolId != null && schoolId != '' && (
          schoolId == request.auth.uid ||
          schoolId == 'personal_' + request.auth.uid ||
          schoolId == 'school_' + request.auth.uid ||
          (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
           get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.schoolId == schoolId &&
           get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.role == 'admin')
        ))
      );
    }

    // Explicit Academy / Sports Coaching Program Tenancy Verification
    function isAcademyMember(programId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (programId != null && programId != '' && (
          (exists(/databases/$(database)/documents/academic_programs/$(programId)) && (
            get(/databases/$(database)/documents/academic_programs/$(programId)).data.headCoachId == request.auth.uid ||
            (request.auth.uid in get(/databases/$(database)/documents/academic_programs/$(programId)).data.coachUids) ||
            (request.auth.token.email != null && request.auth.token.email in get(/databases/$(database)/documents/academic_programs/$(programId)).data.coachEmails)
          ))
        ))
      );
    }

    // ===============================================================
    // Collection Rules: Multi-Tenant Authorization
    // ===============================================================

    // 1. User Profiles: Own user record, school peers, or Super Admin
    match /users/{uid} {
      allow read: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() ||
        (resource != null && resource.data.schoolId != null && isSchoolMember(resource.data.schoolId)) ||
        (resource != null && resource.data.academyId != null && isAcademyMember(resource.data.academyId))
      );
      allow create, update: if isAuthenticated() && (isOwner(uid) || isSuperAdmin());
      allow delete: if isAuthenticated() && (isOwner(uid) || isSuperAdmin());
    }

    // 2. Schools: Scoped to school members and admins
    match /schools/{schoolId} {
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.adminId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isAuthenticated() && (isSchoolAdmin(schoolId) || isSuperAdmin());
    }

    // 3. School Members: Authenticated user self, school members of same school, or school admin
    match /schoolMembers/{uid} {
      allow read: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (resource != null && resource.data.email == request.auth.token.email) ||
        (resource != null && resource.data.schoolId != null && isSchoolMember(resource.data.schoolId))
      );
      allow create: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId))
      );
      allow update: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (resource != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow delete: if isAuthenticated() && (
        isOwner(uid) || 
        isSuperAdmin() || 
        (resource != null && isSchoolAdmin(resource.data.schoolId))
      );
    }

    // 4. Students: Scoped strictly to teacher/creator, school tenant, or Super Admin
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 5. Teams / Classes: Scoped strictly to teacher, school tenant, or Super Admin
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 6. Fitness Test Results: Scoped strictly to teacher, school tenant, or Super Admin
    match /results/{resultId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 7. Practical Assessments (CBSE Board 30M): Scoped to teacher/examiner, school tenant, or Super Admin
    match /practical_assessments/{assessmentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.examinerUid == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 8. Physical Development Interventions & Reassessments: Scoped to teacher, school tenant, or Super Admin
    match /interventions/{interventionId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 9. Academic Coaching Programs: Head Coach, Cohort Coaches, Invite Code, or Super Admin
    match /academic_programs/{programId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isAcademyMember(programId) ||
        (resource != null && resource.data.inviteCode != null)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.headCoachId == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.headCoachId == request.auth.uid) ||
        isAcademyMember(programId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource != null && resource.data.headCoachId == request.auth.uid)
      );
    }

    // 10. Academic Athletes: Scoped strictly to coach or academy tenant or Super Admin
    match /academic_athletes/{athleteId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.createdByCoachId == request.auth.uid ||
        request.resource.data.coachId == request.auth.uid ||
        isAcademyMember(request.resource.data.programId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
    }

    // 11. Academic Assessments: Scoped strictly to coach or academy tenant or Super Admin
    match /academic_assessments/{assessmentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.createdByCoachId == request.auth.uid ||
        request.resource.data.coachId == request.auth.uid ||
        isAcademyMember(request.resource.data.programId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdByCoachId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        isAcademyMember(resource.data.programId)
      );
    }

    // 12. Workloads & Timetables: Strictly scoped to creator or school tenant
    match /workloads/{workloadId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.teacherId == request.auth.uid ||
        isSchoolMember(request.resource.data.schoolId)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        isSchoolMember(resource.data.schoolId)
      );
    }

    // 13. Sports Days: Scoped strictly to school members and admins
    match /sportsDays/{schoolId} {
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin());
      allow create, update, delete: if isAuthenticated() && (isSchoolAdmin(schoolId) || isSuperAdmin());
    }

    // 14. System Error Logs: Authenticated users write error logs; read only by super admin
    match /system_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    // 15. Privacy Audit Logs: Authenticated users write sanitized security logs; read only by user, school admin, or super admin
    match /privacy_audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSchoolAdmin(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    // 16. School Deletion Requests: Verified school admins can submit; read by requester, school admin, or super admin
    match /deletion_requests/{reqId} {
      allow create: if isAuthenticated() && (
        request.resource.data.requestedByUid == request.auth.uid &&
        isSchoolAdmin(request.resource.data.schoolId)
      );
      allow read: if isAuthenticated() && (
        resource.data.requestedByUid == request.auth.uid ||
        isSchoolAdmin(resource.data.schoolId) ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    // 17. Mail Logs: Super Admin only
    match /mail_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // 18. Default fallback: Deny all by default unless super admin
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
