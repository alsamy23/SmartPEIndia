rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'alsamy36@gmail.com' ||
        request.auth.token.email == 'admin@smartpeindia.app' ||
        request.auth.token.email == 'contact@smartpeindia.app' ||
        request.auth.token.email == 'info@smartpeindia.app' ||
        request.auth.uid == 'admin@smartpeindia.app'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        schoolId == null ||
        schoolId == '' ||
        schoolId == 'master_registry' ||
        schoolId == 'personal_' + request.auth.uid ||
        schoolId == 'school_' + request.auth.uid ||
        (schoolId is string && schoolId.matches('^personal_.*')) ||
        (schoolId is string && schoolId.matches('^school_.*')) ||
        (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
         get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.schoolId == schoolId)
      );
    }

    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        schoolId == 'school_' + request.auth.uid ||
        schoolId == 'personal_' + request.auth.uid ||
        (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
         get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.schoolId == schoolId &&
         get(/databases/$(database)/documents/schoolMembers/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (isOwner(uid) || isSuperAdmin());
      allow delete: if isAuthenticated() && (isOwner(uid) || isSuperAdmin());
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isSchoolAdmin(schoolId) || isSuperAdmin() || isSchoolMember(schoolId));
    }

    match /schoolMembers/{uid} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (isOwner(uid) || isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.schoolId)));
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /results/{resultId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /practical_assessments/{assessmentId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /academic_programs/{programId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /academic_athletes/{athleteId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /academic_assessments/{assessmentId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /system_logs/{logId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /workloads/{workloadId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /mail_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /sportsDays/{schoolId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Default catch-all
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSuperAdmin();
    }
  }
}
