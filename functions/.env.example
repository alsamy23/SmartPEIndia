# =========================================================================
# Firebase Cloud Functions Environment Configuration
# =========================================================================

# Primary: Brevo / Sendinblue API Key (https://brevo.com)
# 1. Get your API key from: https://app.brevo.com/settings/keys/api
# 2. Verify sender admin@smartpeindia.com at: https://app.brevo.com/senders
BREVO_API_KEY=your_brevo_v3_api_key_here

# Secondary / Fallback: Resend API Key (https://resend.com)
RESEND_API_KEY=

# Sender Name & Address (Must be a verified sender in Brevo)
FROM_EMAIL="SmartPE India <admin@smartpeindia.com>"

# Application Information
APP_NAME="SmartPE India"
APP_URL="https://smartpeindia.app"
SUPPORT_EMAIL="admin@smartpeindia.com"
