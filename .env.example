# =========================================================================
# SECURITY WARNING: 
# DO NOT prefix sensitive keys with "VITE_". 
# Variables with "VITE_" prefix are exposed to the browser/client-side.
# =========================================================================

# Gemini API Key (Required for AI features)
# This is handled securely on the server.
GEMINI_API_KEY=

# Groq API Key (Optional fallback for Gemini quota limits)
GROQ_API_KEY=

# Optional: Add multiple keys for automatic rotation to bypass quota limits
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=

# =========================================================================
# Corporate Transactional Email Service (Automated Welcome & Feature Updates)
# Choose ANY one of the options below:
# =========================================================================

# Option 1: Resend (Recommended - 3,000 free emails/month at resend.com)
RESEND_API_KEY=

# Option 2: Brevo / Sendinblue (300 free emails/day at brevo.com)
# 1. Get your v3 API key from: https://app.brevo.com/settings/keys/api
# 2. Add admin@smartpeindia.com as a Verified Sender at: https://app.brevo.com/senders
BREVO_API_KEY=your_brevo_v3_api_key_here
FROM_EMAIL="SmartPE India <admin@smartpeindia.com>"
EMAIL_PROVIDER=brevo

# Option 3: Gmail App Password (Use your own account or Google Workspace directly)
GMAIL_USER=admin@smartpeindia.app
GMAIL_APP_PASSWORD=

# Option 4: Custom Domain SMTP Server (e.g., mail.smartpeindia.app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=contact@smartpeindia.app
SMTP_PASS=
FROM_EMAIL="Smart PE India <admin@smartpeindia.app>"


