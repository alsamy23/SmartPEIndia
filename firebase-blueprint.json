{
  "entities": {
    "User": {
      "title": "User",
      "description": "Teacher profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolLogo": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "createdAt": { "type": "string", "format": "date" },
        "registrationDate": { "type": "string", "description": "ISO timestamp of user registration" },
        "nurtureStep1SentAt": { "type": "string", "description": "Day 0 Welcome Email dispatch timestamp" },
        "nurtureStep2SentAt": { "type": "string", "description": "Day 2 Lesson Planner Nurture Email dispatch timestamp" },
        "nurtureStep3SentAt": { "type": "string", "description": "Day 5 Khelo India Fitness Nurture Email dispatch timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "School": {
      "title": "School",
      "description": "School organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "adminId": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date" }
      },
      "required": ["id", "name", "adminId"]
    },
    "SchoolMember": {
      "title": "SchoolMember",
      "description": "Mapping of users to schools with roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "schoolId": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolLogo": { "type": "string" }
      },
      "required": ["uid", "schoolId", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Student profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "rollNumber": { "type": "string" },
        "grade": { "type": "string" },
        "section": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "age": { "type": "number" },
        "dob": { "type": "string", "format": "date" }
      },
      "required": ["id", "teacherId", "schoolId", "name", "grade"]
    },
    "Team": {
      "title": "Team",
      "description": "A class or sports group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "section": { "type": "string" },
        "studentIds": { "type": "array" }
      },
      "required": ["id", "teacherId", "schoolId", "name"]
    },
    "FitnessResult": {
      "title": "FitnessResult",
      "description": "A single fitness test result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "schoolId": { "type": "string" },
        "studentId": { "type": "string" },
        "testId": { "type": "string" },
        "testName": { "type": "string" },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "term": { "type": "string", "enum": ["Term 1", "Term 2", "Term 3"] },
        "rating": { "type": "string" },
        "percentile": { "type": "number" }
      },
      "required": ["id", "teacherId", "schoolId", "studentId", "testId", "value", "date"]
    },
    "AppErrorLog": {
      "title": "AppErrorLog",
      "description": "System error and crash reports",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "componentStack": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "platform": { "type": "string" },
        "url": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["message", "timestamp", "type"]
    },
    "DepartmentWorkload": {
      "title": "DepartmentWorkload",
      "description": "PE Teacher Workload & Curriculum suggestions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "curriculum": { "type": "string" },
        "termsCount": { "type": "number" },
        "periodsCount": { "type": "number" },
        "assignedGrades": { "type": "string" },
        "primaryGames": { "type": "array" },
        "timetableData": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "schoolId", "teacherId", "teacherName", "curriculum", "termsCount", "periodsCount"]
    },
    "SportsDay": {
      "title": "SportsDay",
      "description": "Sports Day tracking data for a school",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "houses": { "type": "string" },
        "events": { "type": "string" },
        "baseScores": { "type": "string" },
        "champions": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["schoolId", "updatedAt"]
    },
    "PracticalAssessment": {
      "title": "PracticalAssessment",
      "description": "CBSE Physical Education Class 11-12 Practical 30-Mark Assessment Record (Subject 048)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "grade": { "type": "string" },
        "section": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "academicYear": { "type": "string" },
        "examType": { "type": "string" },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "fitnessTestScore": { "type": "number" },
        "yogicPracticesScore": { "type": "number" },
        "gameProficiencyScore": { "type": "number" },
        "gameSelected": { "type": "string" },
        "recordFileScore": { "type": "number" },
        "vivaVoceScore": { "type": "number" },
        "totalMarks": { "type": "number" },
        "examinerRemarks": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "draft", "absent"] }
      },
      "required": ["id", "studentId", "teacherId", "schoolId", "fitnessTestScore", "yogicPracticesScore", "gameProficiencyScore", "recordFileScore", "vivaVoceScore", "totalMarks"]
    },
    "MailLog": {
      "title": "MailLog",
      "description": "Audit logs for automated transactional emails and welcome triggers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "recipientName": { "type": "string" },
        "subject": { "type": "string" },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed", "simulated"] },
        "error": { "type": "string" },
        "sentAt": { "type": "string" },
        "triggeredBy": { "type": "string" }
      },
      "required": ["email", "status"]
    },
    "AcademicProgram": {
      "title": "AcademicProgram",
      "description": "Academic sports coaching program independent from formal school database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "programName": { "type": "string" },
        "programType": { "type": "string", "enum": ["school_team", "after_school_academy", "sports_club", "individual_coach"] },
        "sport": { "type": "string" },
        "sportsOffered": { "type": "array", "items": { "type": "string" } },
        "logoUrl": { "type": "string" },
        "adminEmail": { "type": "string" },
        "headCoachId": { "type": "string" },
        "headCoachName": { "type": "string" },
        "coachEmails": { "type": "array", "items": { "type": "string" } },
        "coachNames": { "type": "array", "items": { "type": "string" } },
        "coachUids": { "type": "array", "items": { "type": "string" } },
        "teachersList": { "type": "array" },
        "inviteCode": { "type": "string", "description": "6-character join code for 1-2 co-coaches" },
        "trialExpiresAt": { "type": "string", "description": "ISO timestamp of 5-day academic access window" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "programName", "headCoachId", "inviteCode", "trialExpiresAt"]
    },
    "AcademicAthlete": {
      "title": "AcademicAthlete",
      "description": "Student athletes enrolled in the academic coaching program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "programId": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "sport": { "type": "string" },
        "squadOrBatch": { "type": "string" },
        "jerseyNo": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianContact": { "type": "string" },
        "joiningDate": { "type": "string" },
        "createdByCoachId": { "type": "string" }
      },
      "required": ["id", "programId", "name", "age", "gender", "sport"]
    },
    "AcademicAssessment": {
      "title": "AcademicAssessment",
      "description": "Skill and physical baseline test results for academic coaching athletes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "programId": { "type": "string" },
        "athleteId": { "type": "string" },
        "sportId": { "type": "string" },
        "cycleType": { "type": "string", "enum": ["baseline", "midterm", "summative", "monthly"] },
        "cycleNumber": { "type": "number" },
        "testDate": { "type": "string" },
        "ageBracket": { "type": "string" },
        "coachName": { "type": "string" },
        "programName": { "type": "string" },
        "scores": { "type": "object" },
        "pillarAverages": { "type": "object" },
        "overallScore": { "type": "number" },
        "overallTier": { "type": "string" },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "growthAreas": { "type": "array", "items": { "type": "string" } },
        "coachFeedback": { "type": "string" }
      },
      "required": ["id", "programId", "athleteId", "sportId", "cycleType", "overallScore", "overallTier"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "Teacher profiles" },
    "/schools/{schoolId}": { "schema": "School", "description": "School organizations" },
    "/schoolMembers/{uid}": { "schema": "SchoolMember", "description": "School staff memberships" },
    "/students/{studentId}": { "schema": "Student", "description": "Student records" },
    "/teams/{teamId}": { "schema": "Team", "description": "Class/Team records" },
    "/results/{resultId}": { "schema": "FitnessResult", "description": "Test results" },
    "/practical_assessments/{assessmentId}": { "schema": "PracticalAssessment", "description": "CBSE PE 30M Practical Examination assessments" },
    "/academic_programs/{programId}": { "schema": "AcademicProgram", "description": "Academic sports coaching programs" },
    "/academic_athletes/{athleteId}": { "schema": "AcademicAthlete", "description": "Athletes in academic coaching programs" },
    "/academic_assessments/{assessmentId}": { "schema": "AcademicAssessment", "description": "Skill and physical evaluations in academic coaching programs" },
    "/system_logs/{logId}": { "schema": "AppErrorLog", "description": "Remote application logs" },
    "/mail_logs/{logId}": { "schema": "MailLog", "description": "Transactional email logs" },
    "/workloads/{workloadId}": { "schema": "DepartmentWorkload", "description": "Teacher workload schedules and curriculum setups" },
    "/sportsDays/{schoolId}": { "schema": "SportsDay", "description": "Sports Day tracker data for schools" }
  }
}
